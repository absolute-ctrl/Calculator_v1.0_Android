<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a1a"
    android:padding="16dp">

    <!-- Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#777777"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#f0f0f0"
            android:textSize="48sp"/>
    </LinearLayout>

    <!-- Button Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:columnCount="4"
        android:rowCount="5">

        <!-- Row 1 -->
        <Button android:id="@+id/btnClear"   android:text="C"   android:backgroundTint="#2a2a2a" android:textColor="#aaaaaa"/>
        <Button android:id="@+id/btnSign"    android:text="+/-" android:backgroundTint="#2a2a2a" android:textColor="#aaaaaa"/>
        <Button android:id="@+id/btnPercent" android:text="%"   android:backgroundTint="#2a2a2a" android:textColor="#aaaaaa"/>
        <Button android:id="@+id/btnDiv"     android:text="÷"   android:backgroundTint="#e87c2a" android:textColor="#ffffff"/>

        <!-- Row 2 -->
        <Button android:id="@+id/btn7" android:text="7" android:backgroundTint="#333333" android:textColor="#f0f0f0"/>
        <Button android:id="@+id/btn8" android:text="8" android:backgroundTint="#333333" android:textColor="#f0f0f0"/>
        <Button android:id="@+id/btn9" android:text="9" android:backgroundTint="#333333" android:textColor="#f0f0f0"/>
        <Button android:id="@+id/btnMul" android:text="×" android:backgroundTint="#e87c2a" android:textColor="#ffffff"/>

        <!-- Row 3 -->
        <Button android:id="@+id/btn4" android:text="4" android:backgroundTint="#333333" android:textColor="#f0f0f0"/>
        <Button android:id="@+id/btn5" android:text="5" android:backgroundTint="#333333" android:textColor="#f0f0f0"/>
        <Button android:id="@+id/btn6" android:text="6" android:backgroundTint="#333333" android:textColor="#f0f0f0"/>
        <Button android:id="@+id/btnSub" android:text="−" android:backgroundTint="#e87c2a" android:textColor="#ffffff"/>

        <!-- Row 4 -->
        <Button android:id="@+id/btn1" android:text="1" android:backgroundTint="#333333" android:textColor="#f0f0f0"/>
        <Button android:id="@+id/btn2" android:text="2" android:backgroundTint="#333333" android:textColor="#f0f0f0"/>
        <Button android:id="@+id/btn3" android:text="3" android:backgroundTint="#333333" android:textColor="#f0f0f0"/>
        <Button android:id="@+id/btnAdd" android:text="+" android:backgroundTint="#e87c2a" android:textColor="#ffffff"/>

        <!-- Row 5 -->
        <Button
            android:id="@+id/btn0"
            android:layout_columnSpan="2"
            android:layout_gravity="fill_horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#333333"
            android:text="0"
            android:textColor="#f0f0f0" />
        <Button android:id="@+id/btnDot"   android:text="." android:backgroundTint="#333333" android:textColor="#f0f0f0"/>
        <Button android:id="@+id/btnEqual" android:text="=" android:backgroundTint="#e87c2a" android:textColor="#ffffff"/>

    </GridLayout>

</LinearLayout>